exports[`10-colours.md: plain, 40 columns 1`] = `
"Colours

Inline code: permission colour. A link:
\x1B]8;;https://example.com\x07blue link\x1B]8;;\x07.

no-language fence, also the permission
colour

// comment (green)
const answer = 42; // number (green)
const name = "string"; // string (red)
function greet() { return
console.log(name); } // keyword (blue),
function (yellow), built-in (cyan)

▎ Dim bar, italic text.

~~strikethrough~~ bold italic"
`;

exports[`10-colours.md: plain, 80 columns 1`] = `
"Colours

Inline code: permission colour. A link: \x1B]8;;https://example.com\x07blue link\x1B]8;;\x07.

no-language fence, also the permission colour

// comment (green)
const answer = 42; // number (green)
const name = "string"; // string (red)
function greet() { return console.log(name); } // keyword (blue), function
(yellow), built-in (cyan)

▎ Dim bar, italic text.

~~strikethrough~~ bold italic"
`;

